<%- include('partials/header') %>

<div class="auth-box">
  <h1><%= t('auth.registerTitle') %></h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/register" class="form">
    <label><%= t('auth.username') %><input type="text" name="username" required autofocus minlength="3" /></label>
    <label><%= t('auth.password') %><input type="password" name="password" required minlength="4" /></label>
    <label><%= t('auth.password2') %><input type="password" name="password2" required minlength="4" /></label>
    <button type="submit"><%= t('auth.register') %></button>
  </form>
  <p class="muted"><%= t('auth.haveAccountQ') %> <a href="/login"><%= t('auth.login') %></a></p>
</div>

<%- include('partials/footer') %>
